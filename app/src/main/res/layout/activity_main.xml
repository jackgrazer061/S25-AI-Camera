<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000">
    <androidx.camera.view.PreviewView android:id="@+id/preview" android:layout_width="match_parent" android:layout_height="match_parent" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:gravity="center" android:orientation="vertical" android:padding="20dp" android:background="#66000000">
        <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AI READY" android:textColor="#FFFFFF" android:textStyle="bold" android:padding="8dp"/>
        <LinearLayout android:id="@+id/zoomBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal"/>
        <Button android:id="@+id/shutter" android:layout_width="84dp" android:layout_height="84dp" android:text="●" android:textSize="42sp"/>
    </LinearLayout>
</FrameLayout>
